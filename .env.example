# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
APP_ENV=dev

# Frontend - Cloudflare Pages reads public variables at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3001/realtime
NEXT_PUBLIC_APP_NAME=NexaIoT

# Backend
API_PORT=3001
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:8788
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexaiot
POSTGRES_USER=nexaiot
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://nexaiot:replace-with-local-password@postgres:5432/nexaiot?schema=public

# MQTT / EMQX
MQTT_BROKER_URL=mqtt://emqx:1883
MQTT_CLIENT_ID=nexaiot-api-dev
MQTT_USERNAME=api_service
MQTT_PASSWORD=replace-with-api-mqtt-password
MQTT_TOPIC_ROOT=iot
MQTT_ENVIRONMENT=dev
MQTT_SHARED_GROUP=api-consumers

# EMQX dashboard - demo only for local compose.
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=replace-with-dashboard-password

# Development seed - DEMO only.
DEMO_ADMIN_EMAIL=admin.demo@nexaiot.local
DEMO_ADMIN_PASSWORD=ChangeMe_DEMO_Only_123!
